{
  "expo": {
    "name": "SchoolGo",
    "slug": "schoolgo",
    "scheme": "schoolgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O SchoolGo usa sua localização para acompanhar a rota da van escolar."
        }
      ],
      "expo-font"
    ],
    "android": {
      "package": "com.schoolgo.app"
    },
    "ios": {
      "bundleIdentifier": "com.schoolgo.app",
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
